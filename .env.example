# ── Database ──────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
# Optional. SSL for DB connections: disable | prefer | require. Default prefer
# tries SSL first and falls back to plaintext, so local non-SSL Postgres and
# SSL-enforcing RDS both work without setting this.
# DB_SSL_MODE=require

# ── Redis ─────────────────────────────────────────────────────
# Holds the one-time SDK login codes. In a deployed container the host must be
# the Redis container's name on app-net (redis://artel-redis:6379) — the default
# localhost would be the app container itself, which starts fine and then fails
# every SDK login.
# Authentication goes inside the URL: redis://:your_password@artel-redis:6379
# (use rediss:// for TLS). A trailing /0 is accepted but ignored — Spring reads
# the database index from spring.data.redis.database, not from the URL path.
REDIS_URL=redis://localhost:6379

# ── Internal API port ─────────────────────────────────────────
# `/internal/**` (unauthenticated server-to-server) is served ONLY on this port.
# The public port (8080) answers 404 for those paths, and this port answers 404 for
# everything else. Change it only on a port collision.
# ⚠️ Never publish this port to the host and never point the reverse proxy at it —
# that absence is what keeps the unauthenticated API off the internet.
# See docs/deployment.md § Ports.
ARTEL_INTERNAL_API_PORT=8081

# ── Agent server ──────────────────────────────────────────────
ARTEL_AGENT_BASE_URL=http://localhost:8000

# ── Home (frontend origin) ────────────────────────────────────
ARTEL_HOME_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────
# Browser origins allowed to call this server with credentials.
# The code default lists the deployed domains only, so a local screen is
# blocked until localhost is named here. artel-home is 5173, admin-page 5174.
ARTEL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── GitHub OAuth (optional) ───────────────────────────────────
# Leave both blank to run with email and password login only. GitHub sign-in
# turns on only when both are set; otherwise /oauth2/authorization/github
# answers 404 and GET /api/auth/providers reports "github": false.
# Callback: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Whether a GitHub account the server has never seen gets a new user. Default
# true. When false, only existing users and accounts an ADMIN created by email
# (matched on the GitHub email) can sign in with GitHub; everyone else is sent
# to /login?error=signup_closed. Independent of ARTEL_SIGNUP_OPEN.
ARTEL_GITHUB_SIGNUP_OPEN=true

# ── Email and password signup ─────────────────────────────────
# The first account created through POST /api/auth/signup becomes ADMIN.
# After that, public signup stays closed unless this is true, and an ADMIN
# creates accounts through POST /api/admin/users instead.
ARTEL_SIGNUP_OPEN=false

# ── Login rate limit ──────────────────────────────────────────
# Two separate counters for POST /api/auth/login, both over the same window.
# Kept in memory per server process.
#
# Per email: after ARTEL_LOGIN_MAX_FAILURES failures for one email, every
# login for that email answers 429 too_many_attempts with Retry-After, even
# with the right password, until the window ends.
ARTEL_LOGIN_MAX_FAILURES=10
#
# Per client address: after ARTEL_LOGIN_ADDRESS_MAX_FAILURES failures from one
# address, a wrong password answers 429 instead of 401, but the right password
# still logs in. The address is the leftmost X-Forwarded-For value when that
# header is present, otherwise the connection's address.
# A shared proxy address turns this into a global brake rather than a
# per-client one: with the default Docker install, Docker's userland proxy
# hides the real client, so every visitor arrives as the same bridge address
# and all of them share this one counter. That is why it is much higher than
# the per-email limit. For a per-client limit, have the reverse proxy
# overwrite X-Forwarded-For with the address it saw.
ARTEL_LOGIN_ADDRESS_MAX_FAILURES=100
ARTEL_LOGIN_FAILURE_WINDOW=PT15M

# ── OpenRouter API key ────────────────────────────────────────
# artel-agent-server asks for the key on the internal port
# (GET /internal/settings/llm). A key saved on the admin page wins; this
# variable is the fallback. Either one may be blank.
OPENROUTER_API_KEY=

# ── Secrets key ───────────────────────────────────────────────
# Encrypts values saved on the admin page (the OpenRouter API key) with
# AES-GCM. At least 32 bytes, e.g. `openssl rand -base64 48`. Blank disables
# saving the key on the admin page; OPENROUTER_API_KEY still works. Changing it
# makes the saved key unreadable, so it has to be entered again.
ARTEL_SECRETS_KEY=

# ── JWT session ───────────────────────────────────────────────
# The secret must be at least 32 bytes.
ARTEL_JWT_SECRET=replace_with_at_least_32_random_bytes
ARTEL_JWT_ISSUER=artel-orchestration-server
ARTEL_JWT_AUDIENCE=artel-home
ARTEL_JWT_TTL=PT15M

# ── Session cookie ────────────────────────────────────────────
ARTEL_AUTH_COOKIE=artel_access_token
ARTEL_SECURE_COOKIE=false

# ── S3 bucket ─────────────────────────────────────────────────
ARTEL_S3_BUCKET=your-bucket-name
ARTEL_S3_REGION=ap-northeast-2

# ── S3 credentials ────────────────────────────────────────────
# Optional. Only the bucket and region are required.
# Empty falls back to the AWS default provider chain (instance role, ~/.aws,
# AWS_* process environment). With nothing there either, requests go unsigned —
# which works only on a bucket that allows anonymous access, and the URLs it
# hands out carry no signature and therefore never expire.
# spring-dotenv loads this file into the Spring Environment only, never into the
# process environment, so an AWS_ACCESS_KEY_ID written here is invisible to the
# AWS SDK's own provider. These two keys are the way to pass it in.
# MinIO defaults are minioadmin / minioadmin.
ARTEL_S3_ACCESS_KEY=
ARTEL_S3_SECRET_KEY=

# ── S3 endpoint override ──────────────────────────────────────
# Set only when running against local MinIO (e.g. http://localhost:9000).
# Setting it switches the client to path-style addressing.
# ARTEL_S3_ENDPOINT=

# ── Presigned URL lifetime ────────────────────────────────────
ARTEL_S3_UPLOAD_URL_TTL=PT10M
ARTEL_S3_DOWNLOAD_URL_TTL=PT5M

# ── Upload limit ──────────────────────────────────────────────
# Bytes. 52428800 is 50 MiB.
ARTEL_UPLOAD_MAX_BYTES=52428800

# ── GitHub App: issue tracker export (ARTEL-671) ───────────────
# Leave every value blank to keep the integration off. The server still starts
# and QA runs are unaffected; only the tracker endpoints answer 503.
#
# Register a GitHub App and set:
#   Repository permissions -> Issues: Read & write, Metadata: Read-only
#   Request user authorization (OAuth) during installation: ENABLED
#     Without it the callback carries no `code`, and `code` is the only way to
#     prove the installation_id belongs to the person who sent it. Skip it and
#     any project owner can attach someone else's installation and read their
#     private repository list.
#   User authorization callback URL: <server>/api/tracker/github/setup
#     Enabling the option above locks the Setup URL field; GitHub sends the
#     post-install return to the callback URL instead. Do not turn the option
#     off to get the Setup URL field back — that removes the `code`.
#
# The private key GitHub hands you is PKCS#1; convert it before pasting:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in key.pem
# Newlines may be written as literal \n on one line.
ARTEL_GITHUB_APP_ID=
ARTEL_GITHUB_APP_SLUG=
ARTEL_GITHUB_APP_PRIVATE_KEY=
ARTEL_GITHUB_APP_CLIENT_ID=
ARTEL_GITHUB_APP_CLIENT_SECRET=
