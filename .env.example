# ── Database ──────────────────────────────────────────────────
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=db_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
# Optional. SSL for DB connections: disable | prefer | require. Default prefer
# tries SSL first and falls back to plaintext, so local non-SSL Postgres and
# SSL-enforcing RDS both work without setting this.
# DB_SSL_MODE=require

# ── Redis ─────────────────────────────────────────────────────
# Holds the one-time SDK login codes. In a deployed container REDIS_HOST must be
# the Redis container's name on app-net — the default localhost would be the app
# container itself, which starts fine and then fails every SDK login.
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. Empty means no authentication, which is only acceptable while Redis
# is reachable from app-net alone.
# REDIS_PASSWORD=

# ── Agent server ──────────────────────────────────────────────
ARTEL_AGENT_BASE_URL=http://localhost:8000

# ── Home (frontend origin) ────────────────────────────────────
ARTEL_HOME_URL=http://localhost:5173

# ── GitHub OAuth ──────────────────────────────────────────────
# Real GitHub sign-in needs a registered OAuth app.
# Callback: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── JWT session ───────────────────────────────────────────────
# The secret must be at least 32 bytes.
ARTEL_JWT_SECRET=replace_with_at_least_32_random_bytes
ARTEL_JWT_ISSUER=artel-orchestration-server
ARTEL_JWT_AUDIENCE=artel-home
ARTEL_JWT_TTL=PT15M

# ── Session cookie ────────────────────────────────────────────
ARTEL_AUTH_COOKIE=artel_access_token
ARTEL_SECURE_COOKIE=false

# ── S3 bucket ─────────────────────────────────────────────────
ARTEL_S3_BUCKET=your-bucket-name
ARTEL_S3_REGION=ap-northeast-2

# ── S3 credentials ────────────────────────────────────────────
# Optional. Only the bucket and region are required.
# Empty falls back to the AWS default provider chain (instance role, ~/.aws,
# AWS_* process environment). With nothing there either, requests go unsigned —
# which works only on a bucket that allows anonymous access, and the URLs it
# hands out carry no signature and therefore never expire.
# spring-dotenv loads this file into the Spring Environment only, never into the
# process environment, so an AWS_ACCESS_KEY_ID written here is invisible to the
# AWS SDK's own provider. These two keys are the way to pass it in.
# MinIO defaults are minioadmin / minioadmin.
ARTEL_S3_ACCESS_KEY=
ARTEL_S3_SECRET_KEY=

# ── S3 endpoint override ──────────────────────────────────────
# Set only when running against local MinIO (e.g. http://localhost:9000).
# Setting it switches the client to path-style addressing.
# ARTEL_S3_ENDPOINT=

# ── Presigned URL lifetime ────────────────────────────────────
ARTEL_S3_UPLOAD_URL_TTL=PT10M
ARTEL_S3_DOWNLOAD_URL_TTL=PT5M

# ── Upload limit ──────────────────────────────────────────────
# Bytes. 52428800 is 50 MiB.
ARTEL_UPLOAD_MAX_BYTES=52428800
